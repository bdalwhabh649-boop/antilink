
const { default: makeWASocket, useMultiFileAuthState, DisconnectReason } = require('@whiskeysockets/baileys')
const pino = require('pino')
async function start() {
    const { state, saveCreds } = await useMultiFileAuthState('auth')
    const sock = makeWASocket({ logger: pino({ level: 'silent' }), printQRInTerminal: true, auth: state, browser: ['AntiLink-Bot', 'Chrome', '1.0'] })
    sock.ev.on('creds.update', saveCreds)
    if (!sock.authState.creds.registered) {
        const phone = process.env.PHONE_NUMBER || ''
        if (phone) {
            setTimeout(async () => {
                try { const code = await sock.requestPairingCode(phone); console.log('=== كود الربط: ' + code + ' ===') } catch (e) { console.log('خطأ:', e.message) }
            }, 3000)
        }
    }
    sock.ev.on('connection.update', (u) => {
        const { connection, lastDisconnect } = u
        if (connection === 'open') console.log('البوت اشتغل!')
        if (connection === 'close') { const re = lastDisconnect?.error?.output?.statusCode !== DisconnectReason.loggedOut; if (re) start() }
    })
    sock.ev.on('messages.upsert', async ({ messages }) => {
        const msg = messages[0]
        if (!msg.message || msg.key.fromMe) return
        const jid = msg.key.remoteJid
        if (!jid.endsWith('@g.us')) return
        const text = msg.message.conversation || msg.message.extendedTextMessage?.text || msg.message.imageMessage?.caption || ''
        const hasLink = /https?:\/\/|www\.|t\.me\/|wa\.me\/|chat\.whatsapp\.com/i.test(text)
        if (!hasLink) return
        try {
            await sock.sendMessage(jid, { delete: msg.key })
            const sender = msg.key.participant || msg.key.remoteJid
            await sock.sendMessage(jid, { text: `⚠️ @${sender.split('@')[0]} الروابط ممنوعة! تم حذف رسالتك.`, mentions: [sender] })
        } catch (e) { console.log('لازم البوت يكون مشرف:', e.message) }
    })
}
start()
